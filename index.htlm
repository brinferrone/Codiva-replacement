# index.html

```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Music Playlist</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>🎵 My Music Playlist</h1>
        <p>My Java Final Project — Web Version</p>
    </header>

    <main>

        <section class="stats">
            <div class="stat-card">
                <h3>Total Songs</h3>
                <p id="totalSongs">0</p>
            </div>

            <div class="stat-card">
                <h3>Average Rating</h3>
                <p id="averageRating">0.0/10</p>
            </div>

            <div class="stat-card">
                <h3>Highest Rated</h3>
                <p id="favoriteSong">None</p>
            </div>

            <div class="stat-card">
                <h3>Total Time</h3>
                <p id="totalTime">0:00</p>
            </div>
        </section>

        <section class="playlist-info">
            <h2 id="playlistRating">KEEP WORKING ON IT!</h2>
        </section>

        <section class="buttons">
            <button id="addSongButton">➕ Add Song</button>
            <button id="removeSongButton">🗑️ Remove Song</button>
        </section>

        <section>
            <div id="playlist" class="playlist"></div>
        </section>

    </main>

    <footer>
        <p>Music Playlist Final Project</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
```
